# The name of the bundle. run `databricks bundle schema` to see the full bundle settings schema.
bundle:
  # Do not modify the below line, this autogenerated field is used by the Databricks backend.
  uuid: {{ bundle_uuid }}

  name: {{ .input_project_name }}

variables:
  schema_name:
    description: Schema where tables and models are saved
    default: {{ template `schema_name` .}}
  experiment_name:
    description: Experiment name for the model training.
    default: {{template `experiment_base_name` .}}
  model_name:
    description: Model name for the model training.
    default: {{template `model_name` .}}
  catalog_name:
    description: The catalog name to save the trained model
  # Platform and domain groups
  grp_platform_admin:
    description: Platform Administrators
    default: databricks_{{ .input_dev_catalog_name}}_workspace_admin
  # Access groups

include:
  # Resources folder contains ML artifact resources for the ML project that defines model and experiment
  # And workflows resources for the ML project including model training -> validation -> deployment,
  # {{- if (eq .input_include_feature_store `yes`) }} feature engineering, {{ end }} batch inference, quality monitoring, metric refresh, alerts and triggering retraining
  - ./resources/batch-inference-workflow-resource.yml
  - ./resources/ml-artifacts-resource.yml
  - ./resources/model-workflow-resource.yml
  {{- if (eq .input_include_feature_store `yes`) }}
  - ./resources/feature-engineering-workflow-resource.yml
  {{- end }}
  # TODO: uncomment once monitoring inference table has been created
  # - ./resources/monitoring-resource.yml

# Deployment Target specific values for workspace
targets:

  dev:
    mode: development
    default: true
    variables:
      catalog_name: {{ .input_dev_catalog_name }}
    workspace:
      host: {{ .input_databricks_dev_workspace_host }}

    # Global permissions for all workflows in dev
    permissions:
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_dev_manage_role_group }}_write
        level: CAN_MANAGE
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_run_role_group }}_write
        level: CAN_MANAGE
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_workspace_admin
        level: CAN_MANAGE
  
  dev_qa:
    default: true
    variables:
      catalog_name: {{ .input_dev_catalog_name }}
    workspace:
      host: {{ .input_databricks_dev_workspace_host }}
      root_path: /Shared/.bundle/${bundle.name}
    
    # Global permissions for all workflows in dev_qa
    permissions:
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_dev_manage_role_group }}_write
        level: CAN_MANAGE
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_run_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_workspace_admin
        level: CAN_MANAGE

  uat:
    variables:
      catalog_name: {{ .input_uat_catalog_name }}
    workspace:
      host: {{ .input_databricks_uat_workspace_host }}
      root_path: /Shared/.bundle/${bundle.name}
    
    # Global permissions for all workflows in uat
    permissions:
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_dev_manage_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_run_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_workspace_admin
        level: CAN_MANAGE

  prod:
    variables:
      catalog_name: {{ .input_prod_catalog_name }}
    workspace:
      host: {{ .input_databricks_prod_workspace_host}}
      root_path: /Shared/.bundle/${bundle.name}
    
    # Global permissions for all workflows in prod
    permissions:
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_dev_manage_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_run_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_workspace_admin
        level: CAN_MANAGE
