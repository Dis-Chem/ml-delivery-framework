# Model monitoring workflow
resources:
  jobs:
    model_monitoring_job:
      name: ${bundle.target}-{{ .input_project_name }}-model-monitoring-job
      tasks:
        - task_key: monitored_metric_violation_check
          notebook_task:
            notebook_path: ../monitoring/MonitoredMetricViolationCheck.py
            base_parameters:
              table_name_under_monitor: ${var.catalog_name}.${var.schema_name}.{{ .input_inference_table_name }}
              metric_to_monitor: root_mean_squared_error
              metric_violation_threshold: "100"
              num_evaluation_windows: "5"
              num_violation_windows: "2"
          job_cluster_key: monitoring_cluster
        - task_key: check_violation
          condition_task:
            op: EQUAL_TO
            left: "${tasks.monitored_metric_violation_check.values.is_metric_violated}"
            right: "true"
          depends_on:
            - task_key: monitored_metric_violation_check
        - task_key: trigger_retraining
          depends_on:
            - task_key: check_violation
              outcome: "true"
          run_job_task:
            job_id: ${resources.jobs.model_training_job.id}
            git_source_info: url:${bundle.git.origin_url}; branch:${bundle.git.branch}; commit:${bundle.git.commit}

      job_clusters:
        - job_cluster_key: monitoring_cluster
          new_cluster:
            num_workers: 0
            spark_version: 15.4.x-cpu-ml-scala2.12
            node_type_id: i3.xlarge
            spark_conf:
              spark.master: "local[*, 4]"
              spark.databricks.cluster.profile: singleNode
            custom_tags:
              ResourceClass: SingleNode

      environments:
        - environment_key: default
          spec:
            environment_version: "5"
            dependencies:
              - databricks-sdk>=0.12.0
              - mlflow>=2.9.0
              - numpy>=1.23.0
              - pandas>=1.5.0
              - pyspark>=3.5.0
              - scikit-learn>=1.3.0
      schedule:
        quartz_cron_expression: "0 0 11 * * ?"  # Daily at 11 AM
        timezone_id: Africa/Johannesburg
        pause_status: PAUSED

      # If you want to turn on notifications for this job, please uncomment the below code,
      # and provide a list of emails to the on_failure argument.
      #
      #  email_notifications:
      #    on_failure:
      #      - first@company.com
      #      - second@company.com
