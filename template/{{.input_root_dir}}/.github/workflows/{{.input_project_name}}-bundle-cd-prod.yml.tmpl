# This GitHub workflow deploys Bundle resources (ML resource config and more)
# defined under {{template `project_name_alphanumeric_underscore` .}}/resources/*
# and {{template `project_name_alphanumeric_underscore` .}}/databricks.yml with prod deployment target configs,
# when PRs are merged into the release branch.
#
# Dormant during the dev_qa-only PoC: the job runs only once a PROD_CLIENT_ID Actions
# variable (prod SP for OIDC) is configured. Auth is GitHub OIDC federation.
name: Bundle Deployment for {{ .input_project_name }} Prod

on:
  push:
    branches:
      - '{{ .input_release_branch }}'
  workflow_dispatch:

permissions:
  id-token: write
  contents: read

defaults:
  run:
    working-directory: ./{{template `project_name_alphanumeric_underscore` .}}

env:
  DATABRICKS_HOST: {{template `databricks_prod_workspace_host` .}}
  DATABRICKS_CLIENT_ID: {{`${{ vars.PROD_CLIENT_ID }}`}}
  DATABRICKS_AUTH_TYPE: github-oidc

jobs:
  prod:
    if: {{`${{ vars.PROD_CLIENT_ID != '' }}`}}
    concurrency: {{ .input_project_name }}-prod-bundle-job
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      {{ if (eq .input_project_skeleton `kedro`) }}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      - name: Build Kedro wheel
        run: |
          pip install -e .
          kedro package
      {{ end }}
      - uses: databricks/setup-cli@{{template `cli_version` .}}
      - name: Validate Bundle For Prod
        id: validate
        run: |
          databricks bundle validate -t prod
      - name: Deploy Bundle to Prod
        id: deploy
        run: |
          databricks bundle deploy -t prod
