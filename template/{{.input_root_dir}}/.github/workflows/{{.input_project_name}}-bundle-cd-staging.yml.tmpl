# This GitHub workflow deploys Bundle resources (ML resource config and more)
# defined under {{template `project_name_alphanumeric_underscore` .}}/resources/*
# and {{template `project_name_alphanumeric_underscore` .}}/databricks.yml with staging deployment target configs,
# when PRs are merged into the default branch.
#
# "staging" maps to the dev_qa (UAT) workspace during the dev_qa-only PoC.
# Auth is GitHub OIDC federation — set the SP application ID as vars.STAGING_CLIENT_ID.
name: Bundle Deployment for {{ .input_project_name }} Staging

on:
  push:
    branches:
      - '{{ .input_default_branch }}'
  workflow_dispatch:

permissions:
  id-token: write
  contents: read

defaults:
  run:
    working-directory: ./{{template `project_name_alphanumeric_underscore` .}}

env:
  DATABRICKS_HOST: {{template `databricks_staging_workspace_host` .}}
  DATABRICKS_CLIENT_ID: {{`${{ vars.STAGING_CLIENT_ID }}`}}
  DATABRICKS_AUTH_TYPE: github-oidc

jobs:
  staging:
    concurrency: {{ .input_project_name }}-staging-bundle-job
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      {{ if (eq .input_project_skeleton `kedro`) }}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      - name: Build Kedro wheel
        run: |
          pip install -e .
          kedro package
      {{ end }}
      - uses: databricks/setup-cli@{{template `cli_version` .}}
      - name: Validate Bundle For Staging
        id: validate
        run: |
          databricks bundle validate -t staging
      - name: Deploy Bundle to Staging
        id: deploy
        run: |
          databricks bundle deploy -t staging
