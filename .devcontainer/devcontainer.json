{
  "name": "ML Delivery Framework (MLOps Stacks)",
  // CI runs on Python 3.9; match it so local behavior mirrors the pipeline.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.9-bookworm",
  "features": {
    // Node is used by the `markdown-link-check` (--large) test and is handy generally.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}

    // OPT-IN: uncomment to run the `act`-based integration test
    // (`pytest tests --large`), which executes generated GitHub Actions
    // workflows in containers and therefore needs its own Docker daemon.
    // post-create.sh auto-installs `act` when this is enabled.
    // Note: this makes the container privileged and slower to start.
    // ,"ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/usr/local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "databricks.databricks",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
