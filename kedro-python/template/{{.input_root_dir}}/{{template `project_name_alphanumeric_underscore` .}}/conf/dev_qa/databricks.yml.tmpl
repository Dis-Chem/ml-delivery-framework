# Overrides that `kedro databricks bundle` merges into the job definitions it
# generates under resources/. Read at *generation* time only -- the values below are
# already baked into the committed resources/*.yml, so change them here and re-run
#
#     kedro databricks bundle --overwrite --env dev_qa
#
# rather than hand-editing the generated files.
#
# `${...}` is escaped as `\${...}` so OmegaConf passes it through verbatim for the
# Databricks CLI to resolve at deploy time.

# Applied to every generated workflow and, via the `default` task, to every task.
default:
  job_clusters:
    - job_cluster_key: default
      new_cluster:
        spark_version: {{template `spark_version` .}}
        node_type_id: {{template `cloud_specific_node_type_id` .}}
        num_workers: {{template `num_workers` .}}
        spark_env_vars:
          KEDRO_LOGGING_CONFIG: /Workspace/\${workspace.file_path}/conf/logging.yml
  tasks:
    - task_key: default
      job_cluster_key: default

# Per-workflow overrides, keyed by the workflow name kedro-databricks derives from
# the pipeline: the package name for `__default__`, `<package>_<pipeline>` otherwise.
# Only the `__default__` workflow is scheduled; the per-pipeline ones are run on
# demand with `databricks bundle run`.
{{template `project_name_alphanumeric_underscore` .}}:
  name: \${bundle.target}-{{template `project_name_alphanumeric_underscore` .}}
  schedule:
    quartz_cron_expression: "0 0 9 * * ?" # daily at 9am
    timezone_id: UTC

{{template `project_name_alphanumeric_underscore` .}}_iris:
  name: \${bundle.target}-{{template `project_name_alphanumeric_underscore` .}}-iris
