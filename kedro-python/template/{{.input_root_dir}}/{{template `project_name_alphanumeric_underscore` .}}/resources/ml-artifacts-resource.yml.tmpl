# Allow users to read the experiment
common_permissions: &permissions
  permissions:
    - level: CAN_READ
      group_name: {{ .input_unity_catalog_read_user_group }}

# Allow users to execute models in Unity Catalog
grants: &grants
  grants:
    - privileges:
        - EXECUTE
      principal: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_run_role_group }}_write

# Defines model and experiments
resources:
  registered_models:
    model:
      name: ${var.model_name}
      catalog_name: ${var.catalog_name}
      schema_name: {{ .input_schema_name }}
      comment: Registered model in Unity Catalog for the "{{ .input_project_name }}" ML Project for ${bundle.target} deployment target.
      <<: *grants

  experiments:
    experiment:
      name: /Shared/${var.catalog_name}/{{template `project_name_alphanumeric_underscore` .}}/experiments/${var.experiment_name}
      <<: *permissions
      # MLflow experiments have no `description` field; MLflow stores the description
      # in the reserved `mlflow.note.content` tag, which the UI renders as Description.
      tags:
        - key: mlflow.note.content
          value: MLflow Experiment used to track runs for the {{ .input_project_name }} project.
