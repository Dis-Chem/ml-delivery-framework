# Databricks job for the Kedro `__default__` pipeline: one task per Kedro node,
# wired together by the pipeline's own node dependencies.
#
# GENERATED FILE -- produced by
#
#     kedro databricks bundle --overwrite --env <target>
#
# from the pipeline definitions in src/{{template `project_name_alphanumeric_underscore` .}}/pipelines
# and the overrides in conf/<target>/databricks.yml. Add nodes to the pipeline and
# re-run that command rather than editing the tasks below by hand; anything hand-added
# here (job permissions, notifications, extra tasks) is lost on the next regeneration.
# Bundle-wide settings that must survive belong in databricks.yml instead.
#
# Each task loads the project wheel that `kedro package` builds into ../dist and calls
# the console script declared in pyproject.toml under [project.scripts], passing the
# node name and the workspace-synced conf directory.
resources:
    jobs:
        {{template `project_name_alphanumeric_underscore` .}}:
            name: ${bundle.target}-{{template `project_name_alphanumeric_underscore` .}}
            tasks:
            -   task_key: make_predictions
                depends_on:
                -   task_key: split
                python_wheel_task:
                    package_name: {{template `project_name_alphanumeric_underscore` .}}
                    entry_point: {{template `project_entrypoint` .}}
                    parameters:
                    - --nodes
                    - make_predictions
                    - --conf-source
                    - /Workspace/${workspace.file_path}/conf
                    - --env
                    - ${var.environment}
                libraries:
                -   whl: ../dist/*.whl
                job_cluster_key: default
            -   task_key: report_accuracy
                depends_on:
                -   task_key: make_predictions
                -   task_key: split
                python_wheel_task:
                    package_name: {{template `project_name_alphanumeric_underscore` .}}
                    entry_point: {{template `project_entrypoint` .}}
                    parameters:
                    - --nodes
                    - report_accuracy
                    - --conf-source
                    - /Workspace/${workspace.file_path}/conf
                    - --env
                    - ${var.environment}
                libraries:
                -   whl: ../dist/*.whl
                job_cluster_key: default
            -   task_key: split
                python_wheel_task:
                    package_name: {{template `project_name_alphanumeric_underscore` .}}
                    entry_point: {{template `project_entrypoint` .}}
                    parameters:
                    - --nodes
                    - split
                    - --conf-source
                    - /Workspace/${workspace.file_path}/conf
                    - --env
                    - ${var.environment}
                libraries:
                -   whl: ../dist/*.whl
                job_cluster_key: default
            job_clusters:
            -   job_cluster_key: default
                new_cluster:
                    spark_version: {{template `spark_version` .}}
                    node_type_id: {{template `cloud_specific_node_type_id` .}}
                    num_workers: {{template `num_workers` .}}
                    spark_env_vars:
                        KEDRO_LOGGING_CONFIG: /Workspace/${workspace.file_path}/conf/logging.yml
            schedule:
                quartz_cron_expression: 0 0 9 * * ?
                timezone_id: UTC
