# The name of the bundle. run `databricks bundle schema` to see the full bundle settings schema.
bundle:
  # Do not modify the below line, this autogenerated field is used by the Databricks backend.
  uuid: {{ bundle_uuid }}

  name: {{ .input_project_name }}

variables:
  environment:
    description: |
      Kedro environment (conf/<environment>) that the workflow tasks run against.
      Passed to every task as `--env`. Each deployment target below sets this to
      its own name, so `conf/dev_qa`, `conf/uat`, and `conf/prod`
      line up with the three targets.
    type: string
    default: dev_qa
  node_type_id:
    description: Node type for the job clusters that run the Kedro nodes.
    type: string
    default: {{template `cloud_specific_node_type_id` .}}
  experiment_name:
    description: Experiment name for the model training.
    default: ${bundle.target}-{{template `experiment_base_name` .}}
  model_name:
    description: Model name for the model training.
    default: {{template `model_name` .}}
  catalog_name:
    description: The catalog name to save the trained model
  active_policy_id:
    description: |
      Cluster policy ID injected for the ci-test target only. Left null for
      dev_qa/uat/prod so they keep using whatever default policy already
      applies to those clusters.
    type: string
    default: 00178E2BBA06560A
  experiment_prefix:
    description: >
      Optional path prefix under /Shared for the experiments folder. Set only on
      ci_test so its ephemeral experiments live in a separate subtree from
      dev_qa's, and ci-test-cleanup.yaml's `bundle destroy -t ci_test` can never
      touch dev_qa's data.
    default: ""
  run_as_service_principal_id:
    description: >
      Application (client) ID of the dedicated service principal that owns and
      executes deployed jobs for this target, decoupled from whichever identity
      deployed the bundle. Injected via BUNDLE_VAR_run_as_service_principal_id
      from GitHub Environment variables.

# `kedro package` builds the project wheel into ./dist. Every task loads it as a
# library, so the artifact has to be built before the tasks can start.
artifacts:
  default:
    type: whl
    build: uv run kedro package
    path: .

# Kedro reads its configuration from `--conf-source /Workspace/${workspace.file_path}/conf`,
# so the conf tree has to be synced to the workspace alongside the wheel.
sync:
  include:
    - conf/logging.yml
    - conf/base/*.yml
    - conf/base/*.gitkeep

include:
  # Picks up the ML artifact resources (Unity Catalog registered model and MLflow
  # experiment) plus one resource file per Kedro pipeline, each defining a job with
  # one task per Kedro node. `kedro databricks bundle --overwrite` regenerates the
  # pipeline files, so this is a glob rather than an explicit list.
  - ./resources/*.yml
  # Opt-in resources live one level down so that they are not swept up by the glob
  # above. TODO: uncomment once the monitoring inference table has been created.
  # - ./resources/monitoring-resource.yml

# Deployment Target specific values for workspace
targets:
  dev_qa:  # UC Catalog Name
    default: true
    variables:
      catalog_name: {{ .input_dev_catalog_name }}
      environment: dev_qa
      run_as_service_principal_id: 5cfe3202-b26f-440e-b0fd-4c9e02d32b17
    sync:
      include:
        - conf/dev_qa/*.yml
        - conf/dev_qa/*.gitkeep
    workspace:
      host: {{ .input_databricks_dev_workspace_host }}
      root_path: /Shared/.bundle/{{ .input_domain }}/${bundle.name}

    run_as:
      service_principal_name: ${var.run_as_service_principal_id}

    # Global permissions for all workflows in dev_qa
    permissions:
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_dev_manage_role_group }}_write
        level: CAN_MANAGE
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_run_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_workspace_admin
        level: CAN_MANAGE

  uat:
    variables:
      catalog_name: {{ .input_uat_catalog_name }}
      environment: uat
      run_as_service_principal_id: 9cd0ae32-8f94-4ab9-aa88-2aed50b8c2c4
    sync:
      include:
        - conf/uat/*.yml
        - conf/uat/*.gitkeep
    workspace:
      host: {{ .input_databricks_uat_workspace_host }}
      root_path: /Shared/.bundle/{{ .input_domain }}/${bundle.name}

    run_as:
      service_principal_name: ${var.run_as_service_principal_id}

    # Global  permissions for all workflows in uat
    permissions:
      - group_name: databricks_{{ .input_test_branch }}_{{ .input_domain }}_{{ .input_dev_manage_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_test_branch }}_{{ .input_domain }}_{{ .input_run_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_test_branch }}_{{ .input_domain }}_workspace_admin
        level: CAN_MANAGE

  prod:
    mode: production
    variables:
      catalog_name: {{ .input_prod_catalog_name }}
      environment: prod
    sync:
      include:
        - conf/prod/*.yml
        - conf/prod/*.gitkeep
    workspace:
      host: {{ .input_databricks_prod_workspace_host }}
      # For production deployments there is a single copy, so the per-user default
      root_path: /Shared/.bundle/{{ .input_domain }}/${bundle.name}

    # Global permissions for all workflows in prod
    permissions:
      - group_name: databricks_{{ .input_prod_branch }}_{{ .input_domain }}_{{ .input_dev_manage_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_prod_branch }}_{{ .input_domain }}_{{ .input_run_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_prod_branch }}_{{ .input_domain }}_workspace_admin
        level: CAN_MANAGE
    
    run_as:
      service_principal_name: ${var.run_as_service_principal_id}

  ci-test:
    mode: development
    variables:
      catalog_name: {{ .input_dev_catalog_name }}
      environment: ci_test
      experiment_prefix: "ci_test/"
      run_as_service_principal_id: 5cfe3202-b26f-440e-b0fd-4c9e02d32b17

    sync:
      include:
        - conf/dev_qa/*.yml
        - conf/dev_qa/*.gitkeep
    workspace:
      host: {{ .input_databricks_dev_workspace_host }}
      root_path: /Shared/.bundle/{{ .input_domain }}/ci-tests/${bundle.name}

    # Global permissions for all workflows in ci-test
    permissions:
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_dev_manage_role_group }}_write
        level: CAN_MANAGE
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_{{ .input_run_role_group }}_write
        level: CAN_RUN
      - group_name: databricks_{{ .input_dev_branch }}_{{ .input_domain }}_workspace_admin
        level: CAN_MANAGE
    
    run_as:
      service_principal_name: ${var.run_as_service_principal_id}

    # Merges onto job_clusters[job_cluster_key=default] in the generated
    # pipeline job — does not touch resources/*.yml.tmpl (regenerated by
    # `kedro databricks bundle --overwrite`), and has zero effect on
    # dev_qa/uat/prod since it only exists under this target.
    resources:
      jobs:
        {{template `project_name_alphanumeric_underscore` .}}:
          tags:
            ci_test: "true"
          job_clusters:
            - job_cluster_key: default
              new_cluster:
                node_type_id: i3.xlarge
                num_workers: 0
                policy_id: ${var.active_policy_id}
                apply_policy_default_values: true
