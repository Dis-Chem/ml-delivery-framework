{{ define `project_name_alphanumeric_underscore` -}}
    {{- (regexp `-`).ReplaceAllString ((regexp `[^A-Za-z0-9_-]`).ReplaceAllString (print .input_project_name) ``) `_` -}}
{{- end }}

# Console script name that `kedro package` exposes, and the `entry_point` that
# python_wheel_task invokes. Must stay byte-identical to
# kedro_databricks.cli.bundle.utils.get_entry_point, which derives it from
# `tool.kedro.project_name` as: lowercase -> collapse spaces -> [^a-zA-Z] -> `-`
# -> strip leading/trailing dashes. `input_project_name` is already lowercase and
# space-free by schema pattern, so only the last three steps are reproduced here.
{{ define `project_entrypoint` -}}
    {{- $entrypoint := (regexp `[^a-zA-Z]`).ReplaceAllString (print .input_project_name) `-` -}}
    {{- $entrypoint = (regexp `-+$`).ReplaceAllString $entrypoint `` -}}
    {{- (regexp `^-+`).ReplaceAllString $entrypoint `` -}}
{{- end }}

